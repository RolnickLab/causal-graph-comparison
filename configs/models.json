{
    "common": {
        "training_params": {
            "val_split": 0.2,
            "log_interval": 10
        },
        "test_params": {
            "inference_batch_size": 1000,
            "rollout_timesteps": 20,
            "num_samples": 1000
        },
        "exp_params": {
            "exp_path": "$SCRATCH/training_results",
            "num_workers": 0,
            "pin_memory": false,
            "verbose": true
        }
    },

    "mlp": {
        "model_params": {
            "num_layers": 2
        },
        "training_params": {
            "num_epochs": 5,
            "batch_size": 128,
            "learning_rate": 1e-3,            
            "gamma": 0.7
        }
    },

    "lstm": {
        "model_params": {
            "num_layers": 2
        },
        "training_params": {
            "num_epochs": 100,
            "batch_size": 128,
            "learning_rate": 1e-3,            
            "gamma": 0.7
        }
    },

    "cnn": {
        "model_params": {
            "channels": [32, 64, 128],
            "kernel_sizes": [3, 3, 3],
            "fc_hidden": [512, 256]
        },
        "training_params": {
            "num_epochs": 5,
            "batch_size": 128,
            "learning_rate": 1e-3,            
            "gamma": 0.7
        }
    },

    "vae": {
        "optim_params": {
            "ortho_mu_init": 1e-8,
            "ortho_mu_mult_factor": 1,
            "ortho_h_threshold": 1e8,

            "sparsity_mu_init": 1e-8,
            "sparsity_mu_mult_factor": 1,
            "sparsity_h_threshold": 1e8,

            "acyclic_mu_init": 1e-8,
            "acyclic_mu_mult_factor": 1,
            "acyclic_h_threshold": 1e8
        },
        "wandb": {
            "model": "vae"
        }
    },

    "wandb": {
        "project": "climatem"
    },

    "diff_mapping": {
        "easy": "e", 
        "med_easy": "me",
        "med_hard": "mh",
        "hard": "h"
    }
}